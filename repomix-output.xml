};

// Fixed ECOIN costs per model
const MODEL_COSTS = {
  'real-time-search': 0,
  'am_01j06ytn18ejftedz6dyhz2b15': 0,

  'research-papers': 3,
  'am_01j0rzq4tvfscrgzwac7jv6dr2': 3,

